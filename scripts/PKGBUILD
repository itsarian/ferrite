# Maintainer: Ferrite DM Maintainers <https://github.com/itsarian/ferrite-dm>
pkgname=ferrite-dm
pkgver=0.1.1
pkgrel=1
pkgdesc="High-performance, modern multi-protocol download manager and accelerator"
arch=('x86_64' 'aarch64')
url="https://github.com/itsarian/ferrite-dm"
license=('MIT' 'Apache-2.0')
depends=(
    'openssl'
    'fontconfig'
    'libx11'
    'libxkbcommon'
    'libxkbcommon-x11'
    'wayland'
)
optdepends=(
    'ffmpeg: audio and video transcoding/merging'
    'yt-dlp: extended media URL extraction'
    'xdg-utils: desktop integration and default browser/folder launcher'
)
makedepends=('cargo' 'git' 'cmake' 'pkgconf')
provides=('ferrite-dm' 'fdm-gui' 'ferrite-native-host')
conflicts=('ferrite-dm-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/itsarian/ferrite-dm/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu" 2>/dev/null || cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked -p fdm-gui -p fdm-cli -p fdm-native-host
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --release --locked -p fdm-cli -p fdm-native-host
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Binaries
    install -Dm755 target/release/fdm-gui "$pkgdir/usr/bin/fdm-gui"
    install -Dm755 target/release/ferrite-dm "$pkgdir/usr/bin/ferrite-dm"
    install -Dm755 target/release/ferrite-native-host "$pkgdir/usr/bin/ferrite-native-host"

    # Desktop entry & AppStream
    install -Dm644 resources/linux/ferrite-dm.desktop "$pkgdir/usr/share/applications/ferrite-dm.desktop"
    install -Dm644 resources/linux/io.ferrite_dm.FerriteDM.metainfo.xml "$pkgdir/usr/share/metainfo/io.ferrite_dm.FerriteDM.metainfo.xml"

    # Icons
    for size in 16 32 48 64 128 256 512 1024; do
        install -Dm644 "resources/linux/icons/hicolor/${size}x${size}/apps/ferrite-dm.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ferrite-dm.png"
    done
    install -Dm644 "resources/linux/icons/hicolor/scalable/apps/ferrite-dm.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/ferrite-dm.svg"

    # Licenses
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
