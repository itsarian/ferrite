#!/bin/bash
# Post-install script for Ferrite

APP_PATH="/Applications/Ferrite.app"
BIN_DIR="/usr/local/bin"

if [ -d "$APP_PATH" ]; then
    mkdir -p "$BIN_DIR" 2>/dev/null || true
    if [ -w "$BIN_DIR" ]; then
        ln -sf "$APP_PATH/Contents/MacOS/ferrite" "$BIN_DIR/ferrite"
        ln -sf "$APP_PATH/Contents/MacOS/ferrite-gui" "$BIN_DIR/ferrite-gui"
        ln -sf "$APP_PATH/Contents/MacOS/ferrite-native-host" "$BIN_DIR/ferrite-native-host"
    fi
fi

exit 0
